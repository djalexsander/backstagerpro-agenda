# Supabase public browser configuration.
# Never place service-role keys or other private secrets in VITE_* variables.
VITE_SUPABASE_PROJECT_ID=seu_project_ref
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xXXoRUeKqiqNUpSFsG1oUQ_8bgqn7s_
VITE_SUPABASE_URL=https://seu_project_ref.supabase.co

# VAPID public key for Web Push (public by design - safe to expose in the
# PWA bundle). Must match the VAPID_PUBLIC_KEY secret below.
VITE_VAPID_PUBLIC_KEY=generate-a-vapid-keypair-and-paste-the-public-key-here

# Server-only Supabase Edge Function secrets.
# Configure these with `supabase secrets set`; never prefix them with VITE_.
APP_URL=https://seu-dominio.com
REGISTRATION_RATE_LIMIT_SECRET=gere_um_segredo_forte
ASAAS_API_KEY=your-asaas-api-key
ASAAS_WEBHOOK_TOKEN=generate-at-least-32-random-characters
CHECK_VENCIMENTOS_SECRET=generate-a-different-32-character-random-secret

# Web Push (send-push-notification Edge Function). Generate a VAPID keypair
# (e.g. `npx web-push generate-vapid-keys`) - the private key never leaves
# this list of Edge Function secrets, never expose it as VITE_*.
VAPID_PUBLIC_KEY=same-value-as-VITE_VAPID_PUBLIC_KEY-above
VAPID_PRIVATE_KEY=keep-this-secret-server-side-only
VAPID_SUBJECT=mailto:contato@seu-dominio.com
# Shared secret the dispatch_push_for_notification() trigger sends as
# x-internal-secret when it calls this function via pg_net - configure the
# SAME value in the app_secrets table (see its COMMENT ON TABLE) after deploy.
PUSH_DISPATCH_SECRET=generate-yet-another-32-character-random-secret
