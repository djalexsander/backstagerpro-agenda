# Trusted web application origin used in invite and recovery redirects.
# Use HTTPS outside localhost and do not expose this as a VITE_* secret.
APP_URL=http://localhost:8080

# HMAC secret used to anonymize and throttle self-registration identifiers.
# Generate a random value with at least 32 characters; never expose as VITE_*.
REGISTRATION_RATE_LIMIT_SECRET=replace-with-a-random-secret-at-least-32-characters
