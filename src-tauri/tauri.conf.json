{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Backstage Pro",
  "version": "1.2.2",
  "identifier": "br.com.backstagepro.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Backstage Pro",
        "width": 1600,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "//": "pubkey is the PUBLIC half of the keypair from `npx tauri signer generate` - safe to commit (never the private half). Replace this placeholder before the first signed release; ships as-is with zero risk until then, since tauri-plugin-updater only reads this string during signature verification of an already-downloaded update, never at app startup.",
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0OUEzM0IwOUI1Q0U1MkMKUldRczVWeWJzRE9haEZBZ0JzVWtvSkk5VUNQc0pSTkZWS1Jxa1BTczV5Nmx3OGdEckROeVVZUXQK",
      "endpoints": [
        "https://github.com/djalexsander/backstagerpro-agenda/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
